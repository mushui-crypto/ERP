# 应用配置
APP_PORT=3001
APP_PREFIX=/api
APP_NAME=磐枢工业智能平台

# 数据库类型: mysql | postgres | mssql
DB_TYPE=mysql

# MySQL配置
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=root
DB_MYSQL_DATABASE=panshu_erp

# PostgreSQL配置
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USERNAME=postgres
DB_POSTGRES_PASSWORD=postgres
DB_POSTGRES_DATABASE=panshu_erp

# SQL Server配置
DB_MSSQL_HOST=localhost
DB_MSSQL_PORT=1433
DB_MSSQL_USERNAME=sa
DB_MSSQL_PASSWORD=change-me
DB_MSSQL_DATABASE=panshu_erp

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 文件上传
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760

# 跨域配置
CORS_ORIGIN=*
